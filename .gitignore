# Visual Studio local cache/IntelliSense database (huge, per-machine, never share)
.vs/
*.user
*.suo
*.VC.db
*.VC.VC.opendb

# Compiled server binaries and debug symbols (built locally with srh_lite/tools/build_*.bat;
# share the .exe directly with your collaborator when needed, don't version it)
/*.exe
/*.exe.prev
/*.pdb
/*.pdb.prev
/*.dll
/*.ilk
/*.exp
/*.lib
/*.obj

# Build output placeholders (regenerated by the build scripts)
/generated/*

# Runtime logs, if any get created here
*.log
